{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "datasetop",
  "version": "0.6.0",
  "identifier": "app.datasetop.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "datasetop",
        "width": 440,
        "height": 600,
        "minWidth": 320,
        "minHeight": 300,
        "center": true,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "dragDropEnabled": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
